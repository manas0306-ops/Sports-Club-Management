<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Member Form View -->
    <record id="view_sports_member_form" model="ir.ui.view">
        <field name="name">sports.member.form</field>
        <field name="model">sports.member</field>
        <field name="arch" type="xml">
            <form string="Sports Club Member">
                <header>
                    <button name="action_renew_membership" string="Renew 1 Year" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="member_code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Member Full Name"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Membership Details">
                            <field name="tier"/>
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                            <field name="is_junior"/>
                        </group>
                        <group string="Contact Info">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                        </group>
                    </group>

                    <group string="Entitlements &amp; Privileges">
                        <group>
                            <field name="court_discount" widget="percentage"/>
                            <field name="shop_discount" widget="percentage"/>
                        </group>
                        <group>
                            <field name="bar_discount" widget="percentage"/>
                            <field name="total_spend" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Court Bookings History">
                            <field name="booking_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="court_id"/>
                                    <field name="booking_date"/>
                                    <field name="start_time"/>
                                    <field name="total_amount"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bar Tabs History">
                            <field name="bar_tab_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="table_id"/>
                                    <field name="opened_at"/>
                                    <field name="total_amount"/>
                                    <field name="status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" placeholder="Member preferences, medical info, playing notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Member Tree View -->
    <record id="view_sports_member_tree" model="ir.ui.view">
        <field name="name">sports.member.tree</field>
        <field name="model">sports.member</field>
        <field name="arch" type="xml">
            <tree string="Club Members" decoration-danger="status == 'expired'" decoration-warning="status == 'expiring_soon'" decoration-success="status == 'active'">
                <field name="member_code"/>
                <field name="name"/>
                <field name="tier" widget="badge"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="status" widget="badge"/>
                <field name="total_spend"/>
            </tree>
        </field>
    </record>

    <!-- Member Action Window -->
    <record id="action_sports_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">sports.member</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enroll a new member at the front desk!
            </p>
        </field>
    </record>

    <menuitem id="menu_sports_member_list"
              name="Directory &amp; Signup"
              parent="menu_sports_members_root"
              action="action_sports_member"
              sequence="10"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_sports_gear_tree" model="ir.ui.view">
        <field name="name">product.template.sports.gear.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Pro Shop Inventory" decoration-danger="is_low_shelf_stock">
                <field name="default_code" string="SKU"/>
                <field name="name"/>
                <field name="gear_category" widget="badge"/>
                <field name="list_price" string="Retail Price (₹)"/>
                <field name="unified_shelf_stock" string="Unified Shelf Stock"/>
                <field name="reorder_threshold" string="Reorder Level"/>
                <field name="is_low_shelf_stock" string="Low Stock Warning" widget="boolean"/>
            </tree>
        </field>
    </record>

    <record id="action_sports_shop_products" model="ir.actions.act_window">
        <field name="name">Pro Shop Gear &amp; Inventory</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_sports_gear', '=', True)]</field>
        <field name="context">{'default_is_sports_gear': True}</field>
    </record>

    <menuitem id="menu_sports_shop_products"
              name="Unified Gear Catalog"
              parent="menu_sports_shop_root"
              action="action_sports_shop_products"
              sequence="10"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bar Tab Form View -->
    <record id="view_sports_bar_tab_form" model="ir.ui.view">
        <field name="name">sports.bar.tab.form</field>
        <field name="model">sports.bar.tab</field>
        <field name="arch" type="xml">
            <form string="Bar Tab">
                <header>
                    <button name="action_settle_tab" string="Settle Tab &amp; Close" type="object" class="oe_highlight" invisible="status != 'open'"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,settled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="customer_name"/></h2>
                    </div>
                    <group>
                        <group string="Table &amp; Member">
                            <field name="table_id"/>
                            <field name="member_id"/>
                            <field name="discount_percent" widget="percentage"/>
                            <field name="opened_at"/>
                        </group>
                        <group string="Settlement">
                            <field name="payment_method" invisible="status != 'settled'"/>
                            <field name="closed_at" invisible="status != 'settled'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Food &amp; Drinks (KOT Lines)">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                    <field name="kitchen_notes"/>
                                    <field name="kot_status" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <group class="oe_subtotal_footer">
                        <field name="subtotal"/>
                        <field name="discount_amount"/>
                        <field name="tax_amount"/>
                        <field name="total_amount" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bar Tab Tree View -->
    <record id="view_sports_bar_tab_tree" model="ir.ui.view">
        <field name="name">sports.bar.tab.tree</field>
        <field name="model">sports.bar.tab</field>
        <field name="arch" type="xml">
            <tree string="Running Tabs" decoration-success="status == 'open'" decoration-muted="status == 'settled'">
                <field name="name"/>
                <field name="table_id"/>
                <field name="customer_name"/>
                <field name="member_id"/>
                <field name="opened_at"/>
                <field name="total_amount"/>
                <field name="payment_method"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Table Management Views -->
    <record id="view_sports_bar_table_tree" model="ir.ui.view">
        <field name="name">sports.bar.table.tree</field>
        <field name="model">sports.bar.table</field>
        <field name="arch" type="xml">
            <tree string="Tables" decoration-warning="status == 'occupied'">
                <field name="name"/>
                <field name="area"/>
                <field name="capacity"/>
                <field name="status" widget="badge"/>
                <field name="active_tab_id"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_sports_bar_tabs" model="ir.actions.act_window">
        <field name="name">Running Bar Tabs</field>
        <field name="res_model">sports.bar.tab</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_sports_bar_tables" model="ir.actions.act_window">
        <field name="name">Tables &amp; Floor Map</field>
        <field name="res_model">sports.bar.table</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sports_bar_tabs_list"
              name="Active Tabs"
              parent="menu_sports_bar_root"
              action="action_sports_bar_tabs"
              sequence="10"/>

    <menuitem id="menu_sports_bar_tables_list"
              name="Floor Tables"
              parent="menu_sports_bar_root"
              action="action_sports_bar_tables"
              sequence="20"/>
</odoo>

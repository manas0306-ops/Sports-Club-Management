<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trial Booking Form View -->
    <record id="view_sports_trial_booking_form" model="ir.ui.view">
        <field name="name">sports.trial.booking.form</field>
        <field name="model">sports.trial.booking</field>
        <field name="arch" type="xml">
            <form string="Trial Session Booking">
                <header>
                    <button name="action_convert_to_member" string="1-Click Convert to Member" type="object" class="oe_highlight" invisible="state == 'converted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,completed,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="visitor_name"/></h2>
                    </div>
                    <group>
                        <group string="Trial Session Details">
                            <field name="sport_type"/>
                            <field name="trial_date"/>
                            <field name="time_slot"/>
                            <field name="assigned_coach"/>
                        </group>
                        <group string="Visitor Contact">
                            <field name="visitor_email"/>
                            <field name="visitor_phone"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Trial Booking Tree View -->
    <record id="view_sports_trial_booking_tree" model="ir.ui.view">
        <field name="name">sports.trial.booking.tree</field>
        <field name="model">sports.trial.booking</field>
        <field name="arch" type="xml">
            <tree string="Trial Sessions" decoration-info="state == 'scheduled'" decoration-success="state == 'converted'">
                <field name="name"/>
                <field name="visitor_name"/>
                <field name="sport_type" widget="badge"/>
                <field name="trial_date"/>
                <field name="time_slot"/>
                <field name="assigned_coach"/>
                <field name="visitor_phone"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_sports_trial_bookings" model="ir.actions.act_window">
        <field name="name">Online Trial Sessions</field>
        <field name="res_model">sports.trial.booking</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sports_trial_list"
              name="Visitor Trial Sessions"
              parent="menu_sports_crm_root"
              action="action_sports_trial_bookings"
              sequence="10"/>
</odoo>

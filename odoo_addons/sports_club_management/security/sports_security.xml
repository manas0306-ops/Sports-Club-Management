<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sports_club" model="ir.module.category">
        <field name="name">Sports Club Operations</field>
        <field name="description">User access levels for The Champions Club.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_sports_club_user" model="res.groups">
        <field name="name">Club Front Desk &amp; Bar Staff</field>
        <field name="category_id" ref="module_category_sports_club"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sports_club_manager" model="res.groups">
        <field name="name">Club Owner &amp; General Manager</field>
        <field name="category_id" ref="module_category_sports_club"/>
        <field name="implied_ids" eval="[(4, ref('group_sports_club_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Courts -->
        <record id="court_centre_tennis" model="sports.court">
            <field name="name">Centre Tennis Court 1</field>
            <field name="sport_type">tennis</field>
            <field name="surface_type">clay</field>
            <field name="hourly_rate">800.0</field>
            <field name="has_floodlights">True</field>
        </record>

        <record id="court_cricket_net_a" model="sports.court">
            <field name="name">Cricket Practice Net A</field>
            <field name="sport_type">cricket</field>
            <field name="surface_type">synthetic_turf</field>
            <field name="hourly_rate">1000.0</field>
            <field name="has_floodlights">True</field>
        </record>

        <record id="court_padel_1" model="sports.court">
            <field name="name">Panoramic Padel Court 1</field>
            <field name="sport_type">padel</field>
            <field name="surface_type">hard</field>
            <field name="hourly_rate">900.0</field>
            <field name="has_floodlights">True</field>
        </record>

        <!-- Demo Members -->
        <record id="member_rohan_gold" model="sports.member">
            <field name="name">Rohan Sharma</field>
            <field name="email">rohan.sharma@example.com</field>
            <field name="phone">+91 98200 11223</field>
            <field name="tier">gold</field>
            <field name="start_date" eval="time.strftime('%Y-01-01')"/>
            <field name="expiry_date" eval="(datetime.now() + relativedelta(months=10)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="member_priya_silver" model="sports.member">
            <field name="name">Priya Verma</field>
            <field name="email">priya.verma@example.com</field>
            <field name="phone">+91 98111 22334</field>
            <field name="tier">silver</field>
            <field name="start_date" eval="time.strftime('%Y-02-01')"/>
            <field name="expiry_date" eval="(datetime.now() + relativedelta(months=8)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Demo Bar Tables -->
        <record id="table_t1" model="sports.bar.table">
            <field name="name">Table 1</field>
            <field name="area">main_hall</field>
            <field name="capacity">4</field>
        </record>

        <record id="table_patio1" model="sports.bar.table">
            <field name="name">Patio 1</field>
            <field name="area">terrace</field>
            <field name="capacity">4</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Member Code -->
        <record id="seq_sports_member_code" model="ir.sequence">
            <field name="name">Sports Member Code</field>
            <field name="code">sports.member.code</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Court Booking -->
        <record id="seq_sports_court_booking" model="ir.sequence">
            <field name="name">Court Booking Reference</field>
            <field name="code">sports.court.booking</field>
            <field name="prefix">%(range_year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Bar Tab -->
        <record id="seq_sports_bar_tab" model="ir.sequence">
            <field name="name">Bar Tab Reference</field>
            <field name="code">sports.bar.tab</field>
            <field name="prefix">%(range_year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Trial Booking -->
        <record id="seq_sports_trial_booking" model="ir.sequence">
            <field name="name">Trial Booking Reference</field>
            <field name="code">sports.trial.booking</field>
            <field name="prefix">TRL-%(range_year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
